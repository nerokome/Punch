{
  "name": "attendance-tracker-v1",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --watchAll --no-cache",
    "build": "node ./node_modules/prisma/build/index.js generate && tsc -p .",
    "dev": "nodemon --exec ts-node --transpile-only ./src/index.ts",
    "reset:db": "npx prisma migrate reset",
    "start": "node ./dist/index.js",
    "seed": "ts-node --transpile-only ./src/seed.ts",
    "seed:offices": "ts-node  --transpile-only ./src/seed-offices.ts",
    "migrate": "npx prisma migrate dev --name add_long_lat && npm run dev",
    "deploy": "npx prisma migrate reset --force && npx prisma migrate dev --name add_method_to_attendanceRecord && npm run seed:offices && npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^9.0.1",
    "nodemon": "^3.1.10",
    "prisma": "^6.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "xss-clean": "^0.1.4"
  }
}
